{
  "name": "100p_books",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen-icons": "npx tsx scripts/gen-icons.ts",
    "verify:pdf": "NODE_OPTIONS=\"--require ./scripts/_server-only-stub.cjs\" pnpm exec tsx scripts/verify-pdf.ts",
    "test:pdf": "NODE_OPTIONS=\"--require ./scripts/_server-only-stub.cjs\" pnpm exec tsx scripts/pdf-regression.ts",
    "test:pdf:update": "NODE_OPTIONS=\"--require ./scripts/_server-only-stub.cjs\" pnpm exec tsx scripts/pdf-regression.ts --update",
    "e2e": "playwright test e2e/smoke.spec.ts",
    "e2e:headed": "playwright test --headed",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "e2e:auth": "playwright test --project=authenticated-desktop"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toast": "^1.2.23",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.1",
    "@tosspayments/payment-sdk": "^1.9.3",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/functions": "^3.9.9",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "exceljs": "^4.4.0",
    "exifr": "^7.1.3",
    "fabric": "^6.4.3",
    "heic2any": "^0.0.4",
    "lucide-react": "^1.47.0",
    "nanoid": "^6.0.1",
    "next": "16.3.6",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.29.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^2.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "jsdom": "^25.0.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^7",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "24.x",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "tmp@0": "^0.2.6",
      "form-data@4": "^4.0.6",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@2": "^2.1.4",
      "postcss-selector-parser@6": "^6.1.3",
      "browserslist@4": "^4.28.7",
      "baseline-browser-mapping@2": "^2.11.0",
      "@tootallnate/once@2": "^2.0.1",
      "fabric>canvas": "-",
      "ws": "^8.21.0",
      "jsdom>canvas": "-",
      "exceljs>uuid": "^11.1.1"
    }
  }
}
